{
  "name": "betterself",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run content && vite --host 127.0.0.1",
    "content": "node scripts/build-content.mjs",
    "check": "npm run content && vue-tsc --noEmit",
    "test": "npm run content && vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write src scripts tests content vite.config.ts tsconfig.json package.json README.md docs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@lucide/vue": "1.61.0",
    "idb": "8.0.4",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "fake-indexeddb": "6.2.6",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13",
    "yaml": "2.9.1"
  }
}
